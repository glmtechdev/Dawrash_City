# ─────────────────────────────────────────────────────────────
# Dawrash City — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Dawrash City project) ─────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Members Bridge (GLM Members DB project) ──────────────────
# The Edge Function URL from the Members DB Supabase project
MEMBERS_BRIDGE_URL=https://innidgegsjjeclvkskev.supabase.co/functions/v1/check-member
# Shared secret — must match the value in the Edge Function
MEMBERS_BRIDGE_SECRET=your-bridge-secret-here

# ── App URL ──────────────────────────────────────────────────
# Used to build the magic-link redirect URL.
# Local:      http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
