# ─────────────────────────────────────────────────────────────
# Dawrash City — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Dawrash City project) ─────────────────────────
# Found in: Supabase dashboard → Project Settings → API
# IMPORTANT: This must be the Supabase project URL (*.supabase.co),
#            NOT the Vercel deployment URL (*.vercel.app)
NEXT_PUBLIC_SUPABASE_URL=https://your-dawrash-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── JWT Secret (shared with GLM Members DB) ──────────────────
# Supabase dashboard → members_dbase project → Settings → API → JWT Secret
# Must match exactly what is in the GLM Members DB project.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Members Bridge (GLM Members DB project) ──────────────────
# GLM Members DB Supabase project URL — used to validate GLM tokens
GLM_SUPABASE_URL=https://innidgegsjjeclvkskev.supabase.co
# The Edge Function URL from the Members DB Supabase project
MEMBERS_BRIDGE_URL=https://innidgegsjjeclvkskev.supabase.co/functions/v1/check-member
# Shared secret — must match the value in the Edge Function's secrets
MEMBERS_BRIDGE_SECRET=your-bridge-secret-here
# GLM Members DB anon key — Supabase gateway requires this as Authorization header
# Found in: GLM Members DB Supabase → Settings → API → Project API keys → anon/public
MEMBERS_BRIDGE_ANON_KEY=your-glm-anon-key-here

# ── App URL ──────────────────────────────────────────────────
# Used to build the magic-link redirect URL.
# Local:      http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000